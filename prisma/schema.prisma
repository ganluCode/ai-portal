generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

// 共用表，Portal 负责建表，Baize 直接复用
// system_ 前缀表示 Portal 与 Baize 共用的基础表
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?  @unique // 支持 username 登录
  password    String
  role        Role     @default(USER)
  avatar      String?
  isActive    Boolean  @default(true)
  // Baize 扩展字段（建表时一并加入，Baize 直接复用）
  apiKeyHash  String?
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_users")
}
